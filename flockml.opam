# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A small PyTorch-like neural network library written from scratch in OCaml"
description:
  "Tensors, reverse-mode automatic differentiation, layers, losses, optimizers (SGD, Adam) and an MNIST training pipeline, built without external numerical libraries. The optional flockml.blas library adds a Bigarray backend with BLAS (Accelerate or OpenBLAS), in float64 or float32."
maintainer: ["Alexander Jankowich"]
authors: ["Alexander Jankowich"]
license: "MIT"
homepage: "https://github.com/Alexander-Jankowich/FlockML"
bug-reports: "https://github.com/Alexander-Jankowich/FlockML/issues"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.0"}
  "ounit2" {with-test}
  "odoc" {with-doc}
]
depopts: ["dune-configurator"]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Alexander-Jankowich/FlockML.git"
